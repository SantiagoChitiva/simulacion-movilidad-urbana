@mastersthesis{Molina_Des_2024,
  author = {Molina Contreras, Juan Camilo},
  title = {Desafíos institucionales en la planeación y gestión de la movilidad en las Metrópolis: los accesos urbanos de Bogotá como estudio de caso},
  abstract = {La planeación y gestión de la movilidad metropolitana constituye uno de los principales desafíos que enfrentan las ciudades. Las deficiencias en la infraestructura y los servicios de transporte regional impactan negativamente su productividad. Esta investigación argumenta que, para responder a este desafío, se requieren esquemas institucionales que promuevan la gobernanza metropolitana, faciliten la implementación de políticas y proyectos regionales, e integren la movilidad con el ordenamiento territorial. A partir del análisis de los accesos urbanos de Bogotá, se concluye que su actual arreglo institucional se caracteriza por una gobernanza territorial limitada debido a la fragmentación, superposición o atomización de competencias; la falta de acuerdos interinstitucionales entre diferentes niveles de gobierno; y la desarticulación entre políticas sectoriales. Superar estas barreras institucionales a través de la descentralización de competencias y el desarrollo de entidades especializadas en la planeación y gestión de la movilidad a nivel metropolitano se resalta como prioritario. La Región Metropolitana Bogotá Cundinamarca y la Agencia Regional de Movilidad representan una oportunidad para mejorar la
    conectividad regional mediante un marco de planificación y gestión más efectivo para la movilidad y su integración con el ordenamiento territorial.},
  year = {2024},
  institution = {Universidad Externado de Colombia},
  url = {https://bdigital.uexternado.edu.co/handle/001/26701},
}

