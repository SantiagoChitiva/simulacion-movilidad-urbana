  author       = {{Universidad Piloto de Colombia}},
  institution  = {Universidad Piloto de Colombia},
  address      = {Bogotá D.C., Colombia},
  abstract     = {Desde hace algún tiempo, el estudio de la segregación ha sido tema de interés en las ciudades latinoamericanas. En Bogotá, diferentes trabajos académicos giran en torno al examen del fenómeno que se observa en inequidades espaciales con implicaciones sociales y económicas. La segregación como concepto teórico amplio permite identificar y examinar diferentes fenómenos que se producen sobre el espacio urbano. El objetivo de este artículo es analizar la segregación socioespacial en Bogotá a partir de las posiciones ocupacionales, utilizando como fuente de información la Encuesta Multipropósito 2017. Los resultados se contrastan con trabajo de campo realizado en el barrio El Paraíso de la localidad de Ciudad Bolívar, en el marco del proyecto de investigación “Movilidad urbana y el entorno como generadores de ciudadanía” liderado por docentes de la Maestría en Gestión Urbana de la Universidad Piloto de Colombia.},
  keywords     = {Segregación socioespacial, Posiciones ocupacionales, Ciudad Bolívar, Bogotá},
  language     = {Spanish},
  note         = {Artículo académico institucional, Universidad Piloto de Colombia}
}

