.venv
.pytest_cache/
__pycache__
simulation_service.egg-info/

# se ignoran archivos generados por el ETL
*rou*.xml
*trips.xml
output/
# corridas lanzadas desde la API (src/api/jobs.py)
runs/
# catálogo de semáforos y otros derivados de la red
cache/
# precalculadas/ se versiona, pero solo comprimido (python -m etl.precalculadas)
precalculadas/**/*.geojson
precalculadas/**/*.tmp
# programas de semáforo que guarda el usuario desde la ficha (Configurar)
src/etl/sumo/scenarios/*/programa_*.xml
# buses y paradas del GTFS (python -m etl.sumo.transporte_publico): se versionan aunque sean *rou*.xml
!src/etl/sumo/scenarios/*/pt_vehiculos.rou.xml
# insumos intermedios del GTFS y del tráfico de paso (se regeneran)
src/etl/sumo/scenarios/*/gtfs_usaquen.zip
src/etl/sumo/scenarios/*/.trafico_paso_*/
src/etl/sumo/scenarios/*/.gtfs2pt/
src/etl/sumo/scenarios/*/.pt_paradas/
