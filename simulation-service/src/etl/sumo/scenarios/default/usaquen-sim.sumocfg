<?xml version="1.0" encoding="UTF-8"?>

<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="usaquen_3d.net.xml"/>
        <route-files value="usaquen_am_multimodal.rou.xml"/>
        <additional-files value="usaquen.taz.xml"/>
    </input>

    <output>
        <output-prefix value="usaquen_am."/>

        <tripinfo-output value="output/tripinfo.xml"/>
        <tripinfo-output.write-unfinished value="true"/>

        <personinfo-output value="output/personinfo.xml"/>

        <fcd-output value="output/fcd.xml"/>
        <fcd-output.geo value="true"/>
        <!-- FCD cada 2 s: con la demanda completa a 1 s pesa varios GB -->
        <device.fcd.period value="2"/>

        <vehroute-output value="output/vehroute.xml"/>
        <vehroute-output.exit-times value="true"/>

        <summary-output value="output/summary.xml"/>
        <summary-output.period value="300"/>

        <statistic-output value="output/statistics.xml"/>
        <!-- sin emission-output: con la demanda completa pesa ~2 GB y no se usa -->
    </output>

    <time>
        <begin value="25200"/>
        <end value="36000"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="300"/>
        <max-num-vehicles value="5000"/>
        <max-depart-delay value="900"/>

        <pedestrian.model value="striping"/>
        <pedestrian.striping.stripe-width value="0.55"/>
        <pedestrian.striping.jamtime value="30"/>
    </processing>

    <routing>
        <device.rerouting.probability value="1"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.pre-period value="300"/>
    </routing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
        <log value="output/sumo.log"/>
    </report>

    <random_number>
        <seed value="42"/>
    </random_number>

</configuration>
